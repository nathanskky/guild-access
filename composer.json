{
    "name": "guild/access",
    "description": "IU Login (OIDC) authentication middleware for PHP; ACM/Grouper authorization and IU external (Guest) account support planned.",
    "type": "library",
    "authors": [
        {
            "name": "Nathan Skky Rodriguez",
            "email": "nsrodrig@iu.edu"
        }
    ],
    "require": {
        "php": ">=8.2 <8.6",
        "jumbojett/openid-connect-php": "^1.0",
        "laminas/laminas-diactoros": "^3.8",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "laminas/laminas-httphandlerrunner": "^2.13"
    },
    "autoload": {
        "psr-4": {
            "Guild\\Access\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Guild\\Access\\Test\\": "tests"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "monolog/monolog": "^3.10"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "check": [
            "@test",
            "@analyse"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the guild-access test suite (fails if no tests run).",
        "analyse": "Run PHPStan at level max over src/.",
        "check": "Run tests then static analysis. Stops at the first failure."
    }
}
