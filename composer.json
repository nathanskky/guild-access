{
    "name": "shadow/access",
    "description": "IU Login (CAS, OIDC) and access control (ACM) middleware, with IU Guest account resolution support (OIDC).",
    "type": "library",
    "authors": [
        {
            "name": "Nathan Skky Rodriguez",
            "email": "nsrodrig@iu.edu"
        }
    ],
    "require": {
        "php": ">=8.2 <8.5",
        "apereo/phpcas": "~1.6.0",
        "league/container": "^5.1",
        "jumbojett/openid-connect-php": "^1.0",
        "guzzlehttp/guzzle": "^7.10",
        "laminas/laminas-diactoros": "^3.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Shadow\\Access\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shadow\\Access\\Test\\": "tests"
        }
    }
}
